# Supabase (JANGAN masukkan kunci asli ke dalam repo)
# Ganti nilai di bawah ini secara lokal dalam .env.local dan konfigurasi Environment di Netlify
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# PERINGATAN: Jangan pernah commit service role key asli
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-9240032692197811
# Optional: toggle to enable ads rendering in production (guarded by valid config in code)
NEXT_PUBLIC_ADSENSE_ENABLED=true
# Ad slots (isi dengan slot ID asli dari AdSense)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://wacanahukum.com
NEXT_PUBLIC_SITE_NAME=Wacana Hukum
NEXT_PUBLIC_BASE_URL=https://wacanahukum.com

# Midtrans Core API (set di Environment Netlify, jangan commit nilai asli)
# Set MIDTRANS_IS_PRODUCTION ke 'true' untuk lingkungan produksi
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Gunakan nilai contoh, JANGAN commit nilai asli di repo/public docs
MIDTRANS_FIXED_PRICE=10000
# Payment types yang diizinkan (opsional, pisahkan dengan koma). Contoh: qris,gopay,bank_transfer
MIDTRANS_ALLOWED_PAYMENT_TYPES=qris,gopay,bank_transfer
# Default payment type saat request tidak mengirim payment_type
MIDTRANS_DEFAULT_PAYMENT_TYPE=qris
# URL redirect untuk payment success dan error (gunakan domain valid)
MIDTRANS_FINISH_URL=https://example.com/payment-success
MIDTRANS_ERROR_URL=https://example.com/payment-error

# Optional: toggle to enable ads rendering in production (guarded by valid config in code)
NEXT_PUBLIC_ADSENSE_ENABLED=true
# Ad slots (isi dengan slot ID asli dari AdSense)
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_MOBILE=