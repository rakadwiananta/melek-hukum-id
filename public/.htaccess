# Redirect from old domain to new domain
RewriteEngine On

# Redirect bicarahukum.my.id to wacanahukum.com
RewriteCond %{HTTP_HOST} ^(www\.)?bicarahukum\.my\.id$ [NC]
RewriteRule ^(.*)$ https://wacanahukum.com/$1 [R=301,L]

# Redirect www.wacanahukum.com to wacanahukum.com
RewriteCond %{HTTP_HOST} ^www\.wacanahukum\.com$ [NC]
RewriteRule ^(.*)$ https://wacanahukum.com/$1 [R=301,L]

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Cache control for static assets
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Cache control for HTML
<FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>